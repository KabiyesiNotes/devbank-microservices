{
  "family": "devbank-frontend-td",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::761317711277:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "frontend",
      "image": "761317711277.dkr.ecr.us-east-1.amazonaws.com/devbank-frontend:latest",
      "portMappings": [{"containerPort": 80, "protocol": "tcp"}],
      "essential": true,
      "environment": [{"name": "BACKEND_URL", "value": "http://devbank-backend:3002"}],
      "logConfiguration": {"logDriver": "awslogs", "options": {"awslogs-group": "/ecs/devbank-frontend", "awslogs-region": "us-east-1", "awslogs-stream-prefix": "ecs"}}
    }
  ]
}
